# Target backend under test.
BASE_URL=http://localhost:8080

# Scenario: smoke | load | read | stress | spike | soak | write
SCENARIO=load

# --- load shape ---
# Concurrent virtual users for VU-based scenarios (load, stress, soak).
VUS=20
# Duration of the steady phase for ramping scenarios.
DURATION=5m
# Duration of the smoke scenario (kept short for deploy gates).
SMOKE_DURATION=30s
# Target requests per second for the arrival-rate `read` scenario.
READ_RPS=50
# Average seconds a virtual user pauses between iterations (0 = max throughput).
THINK_TIME=1

# Per-request timeout for the document/chunk endpoints.
READ_TIMEOUT=5s

# --- seed data (optional) ---
# When empty, ids are discovered from GET /documents during setup().
DOCUMENT_ID=
CHUNK_ID=
MAX_SEED_DOCS=25
MAX_SEED_CHUNKS=50

# --- thresholds ---
# Allowed fraction of failed requests.
MAX_ERROR_RATE=0.01
# Required fraction of passing checks.
MIN_CHECK_RATE=0.99
# Read latency budget in milliseconds.
READ_P95_MS=300
READ_P99_MS=800

# --- destructive writes (opt-in) ---
# SCENARIO=write deletes data in Neo4j permanently. Only enable it against a
# disposable stack, and always name the exact targets.
ALLOW_DESTRUCTIVE=false
DELETE_DOCUMENT_IDS=
DELETE_CHUNK_IDS=

# Optional: write the k6 summary JSON to this path.
# SUMMARY_EXPORT=loadtest/results/summary.json
