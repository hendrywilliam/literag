# Server
PORT=8080

# RAG (FastAPI) service
RAG_URL=http://localhost:8000

# LLM provider (OpenRouter, OpenAI-compatible)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-latest

# PostgreSQL (repo layer — backlog)
DATABASE_URL=

# Neo4j graph database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Redis cache for the read paths (documents, chunks, RAG queries).
# Point at a separate DB index when sharing the instance with the Celery broker.
REDIS_URL=redis://localhost:6379/1
# Cache is opt-in: set CACHE_ENABLED=true. REDIS_URL alone does not enable it.
CACHE_ENABLED=true
# Read cache TTL. Keep it short if freshly indexed document status matters.
CACHE_TTL=30s
