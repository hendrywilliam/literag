{
  "openapi": "3.0.3",
  "info": {
    "title": "Literag Backend API",
    "version": "1.0.0",
    "description": "RAG chat backend. Queries the Python RAG service for context, streams a completion from the LLM provider (OpenRouter), returns the retrieval sources, and exposes document/chunk management backed directly by Neo4j."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development"
    }
  ],
  "paths": {
    "/chat/completion": {
      "post": {
        "summary": "Stream a chat completion with RAG context",
        "description": "Retrieves relevant context from the RAG service, injects it into the prompt, and streams the LLM answer as Server-Sent Events. The stream ends with a `sources` event containing the retrieved sources.",
        "operationId": "chatCompletion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-Sent Events stream. Each `data:` line is a JSON payload: an OpenAI-compatible `choices[].delta.content` token chunk, a final `[DONE]` marker, and a trailing `sources` event with the retrieved context.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/ChatStreamEvent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing question",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "RAG retrieval or LLM completion failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "summary": "List all documents",
        "operationId": "listDocuments",
        "responses": {
          "200": {
            "description": "List of documents.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentSummary"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Neo4j query failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/documents/delete": {
      "post": {
        "summary": "Bulk delete documents and their chunks",
        "operationId": "deleteDocuments",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deletion result with number of deleted nodes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid document_ids",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Neo4j query failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}": {
      "get": {
        "summary": "Get a document by id",
        "operationId": "getDocument",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            }
          },
          "404": {
            "description": "Document not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Neo4j query failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}/chunks": {
      "get": {
        "summary": "List chunks of a document",
        "operationId": "listChunks",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of chunks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Chunk"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Neo4j query failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chunks/{chunk_id}": {
      "get": {
        "summary": "Get a chunk by id",
        "operationId": "getChunk",
        "parameters": [
          {
            "name": "chunk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chunk details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chunk"
                }
              }
            }
          },
          "404": {
            "description": "Chunk not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Neo4j query failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chunks/delete": {
      "post": {
        "summary": "Bulk delete chunks",
        "operationId": "deleteChunks",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteChunksRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deletion result with number of deleted chunks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid chunk_ids",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Neo4j query failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": {
            "type": "string",
            "description": "The user's question."
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of context chunks to retrieve from the RAG service. Defaults to the RAG service's configured value when omitted."
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "chunk_count": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Chunk": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "chunk_index": {
            "type": "integer"
          }
        }
      },
      "DeleteDocumentsRequest": {
        "type": "object",
        "required": ["document_ids"],
        "properties": {
          "document_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeleteChunksRequest": {
        "type": "object",
        "required": ["chunk_ids"],
        "properties": {
          "chunk_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeleteResult": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "integer"
          }
        }
      },
      "Source": {
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        }
      },
      "ChatStreamEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/DeltaChunk"
          },
          {
            "$ref": "#/components/schemas/SourcesEvent"
          }
        ]
      },
      "DeltaChunk": {
        "type": "object",
        "description": "OpenAI-compatible completion token chunk.",
        "properties": {
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "delta": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "SourcesEvent": {
        "type": "object",
        "description": "Trailing event carrying the retrieved RAG sources.",
        "required": ["type", "sources"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["sources"]
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
