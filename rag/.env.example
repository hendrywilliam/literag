# VoyageAI
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# DeepSeek (OpenAI-compatible) — for the relation-building agent
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Celery broker + result backend
REDIS_URL=redis://localhost:6379/0

# Relation building
RELATION_ENABLED=true
RELATION_CANDIDATES=5

# Neo4j
# Local Docker: bolt://localhost:7687
# AuraDB: neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=pleaseletmein
# Database name. Local Docker default is "neo4j".
# AuraDB: usually equals your instance name (NOT "neo4j").
NEO4J_DATABASE=neo4j

# Optional: custom Neo4j vector index name (default: "vector")
NEO4J_INDEX_NAME=vector
